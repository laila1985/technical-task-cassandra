-- =====================================================================
-- PCAP Processor - Cassandra keyspace schema (Level 4)
-- Target: Cassandra 3.x / CQL 3
--
-- The keyspace is created automatically by the application on first run
-- using the replication factor from application.properties.
-- This file documents the schema and can also be applied manually:
--    cqlsh -f schema.cql
-- =====================================================================

CREATE KEYSPACE IF NOT EXISTS pcap_analysis
    WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1}
     AND durable_writes = true;

USE pcap_analysis;

-- ---------------------------------------------------------------------
-- captures: one row per processed PCAP file (aggregation, Level 3).
-- file_id is a UUID generated by the application.
-- ---------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS captures (
    file_id        uuid PRIMARY KEY,
    file_name      text,
    file_size      bigint,
    first_ts       timestamp,      -- earliest packet timestamp
    last_ts        timestamp,      -- latest packet timestamp
    duration_ms    bigint,         -- last_ts - first_ts
    packet_count   bigint,
    byte_count     bigint,
    ethernet_count bigint,
    ip_count       bigint,
    tcp_count      bigint,
    udp_count      bigint,
    other_count    bigint,
    status         text,           -- PROCESSED / FAILED
    error          text,
    processed_at   timestamp
);

-- ---------------------------------------------------------------------
-- packets: detailed packet records (Level 3).
-- PARTITION KEY (file_id) + CLUSTERING KEY (packet_index) groups all
-- packets of one capture contiguously and keeps them ordered by time.
-- ---------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS packets (
    file_id         uuid,
    packet_index    bigint,
    timestamp       timestamp,
    protocol        text,          -- ETHERNET / IPV4 / TCP / UDP / ARP / ICMP / HTTP ...
    src_mac         text,
    dst_mac         text,
    ether_type      text,
    src_ip          text,
    dst_ip          text,
    ip_protocol     int,
    src_port        int,
    dst_port        int,
    tcp_flags       text,
    seq             bigint,
    ack             bigint,
    payload_size    int,
    total_size      int,
    http_host       text,
    http_uri        text,
    http_method     text,
    http_status     int,
    http_content_type text,
    PRIMARY KEY (file_id, packet_index)
);

-- ---------------------------------------------------------------------
-- protocols: count of packets grouped by (file, protocol).
-- ---------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS protocols (
    file_id     uuid,
    protocol    text,
    count       bigint,
    PRIMARY KEY (file_id, protocol)
);

-- ---------------------------------------------------------------------
-- ip_pairs: aggregated traffic between a pair of IPs (Level 3 aggregation).
-- ---------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS ip_pairs (
    file_id     uuid,
    src_ip      text,
    dst_ip      text,
    packet_count bigint,
    byte_count  bigint,
    first_ts    timestamp,
    last_ts     timestamp,
    PRIMARY KEY (file_id, src_ip, dst_ip)
);

-- ---------------------------------------------------------------------
-- endpoints: aggregation keyed by a single IP (helps UI search by IP).
-- ---------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS endpoints (
    file_id      uuid,
    ip           text,
    mac          text,
    packets_in   bigint,
    packets_out  bigint,
    bytes_in     bigint,
    bytes_out    bigint,
    first_ts     timestamp,
    last_ts      timestamp,
    PRIMARY KEY (file_id, ip)
);

-- ---------------------------------------------------------------------
-- images: extracted HTTP images (Level 5). file_path maps to the folder
-- where the image was written.
-- ---------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS images (
    file_id      uuid,
    image_id     uuid,
    src_ip       text,
    dst_ip       text,
    url          text,
    content_type text,
    size         bigint,
    file_path    text,
    extracted_at timestamp,
    PRIMARY KEY (file_id, image_id)
);

-- ---------------------------------------------------------------------
-- Secondary indexes used by the UI search (Level 4).
-- These are only created if the 'search' feature is enabled; Cassandra
-- secondary indexes are acceptable for a small-scale search UI.
-- ---------------------------------------------------------------------
CREATE INDEX IF NOT EXISTS idx_packets_protocol ON packets (protocol);
CREATE INDEX IF NOT EXISTS idx_packets_src_ip  ON packets (src_ip);
CREATE INDEX IF NOT EXISTS idx_packets_dst_ip  ON packets (dst_ip);
CREATE INDEX IF NOT EXISTS idx_protocols_protocol ON protocols (protocol);
CREATE INDEX IF NOT EXISTS idx_endpoints_ip ON endpoints (ip);
